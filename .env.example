# Google Calendar (share the calendar with the service account email)
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/google-sa.json
GOOGLE_CALENDAR_ID=
# e.g. a public holiday calendar, comma separated
GOOGLE_EXTRA_BUSY_CALENDARS=

# Optional
SLACK_WEBHOOK_URL=
DATABASE_URL=postgres://agent:agent@db:5432/agent
ADMIN_TOKEN=
BOOKING_AGENT_CONFIG=/app/business.json
BUFFER_QUIET_MS=8000
PORT=3000
