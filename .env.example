# Claude
ANTHROPIC_API_KEY=
BOOKING_AGENT_MODEL=claude-opus-5-5
BOOKING_AGENT_EFFORT=low

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
